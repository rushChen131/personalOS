# ---------------------------------------------------------------------------
# PersonalOS environment template. Copy to .env and adjust.
# Local SQLite development needs NO changes beyond this file's defaults.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_NAME=PersonalOS API
APP_VERSION=1.2.0
DEBUG=true

# Change this before exposing the API beyond localhost.
SECRET_KEY=personalos-dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---------------------------------------------------------------
# Local default (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./personalos.db
# Production (PostgreSQL + pgvector, matches docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://personalos:personalos@postgres:5432/personalos

# --- Redis ------------------------------------------------------------------
# Only required for the arq worker / Redis event bus; local mode uses the
# in-process bus and dispatcher.
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO / S3) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=personalos
S3_SECRET_KEY=personalos123
S3_BUCKET=personalos

# --- LLM --------------------------------------------------------------------
# "mock" needs no key and returns deterministic structured replies.
# Set to "openai" (and provide OPENAI_API_KEY) to use the real provider.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# --- App behaviour ----------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# Seeds demo@personalos.local / demo1234 on first boot.
SEED_DEMO_USER=true

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
