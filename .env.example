# ---------------------------------------------------------------------------
# PersonalOS environment template. Copy to .env and adjust.
# Local SQLite development needs NO changes beyond this file's defaults.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_NAME=PersonalOS API
APP_VERSION=1.2.0
DEBUG=true

# Change this before exposing the API beyond localhost.
SECRET_KEY=personalos-dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---------------------------------------------------------------
# Local default (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./personalos.db
# Production (PostgreSQL + pgvector, matches docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://personalos:personalos@postgres:5432/personalos

# --- Redis ------------------------------------------------------------------
# Only required for the arq worker / Redis event bus; local mode uses the
# in-process bus and dispatcher.
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO / S3) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=personalos
S3_SECRET_KEY=personalos123
S3_BUCKET=personalos

# --- LLM --------------------------------------------------------------------
# "mock" needs no key and returns deterministic structured replies.
# Set to "openai" (and provide OPENAI_API_KEY) to use the real provider.
#
# The "openai" provider is the OpenAI *protocol*, not necessarily OpenAI the
# service. OPENAI_BASE_URL points it at a compatible endpoint; the value is a
# BASE, because the SDK appends /chat/completions itself. Model ids are
# configured separately since such an endpoint usually serves its own models.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_HEAVY_MODEL=gpt-4o
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Embeddings -------------------------------------------------------------
# Configured SEPARATELY from chat: the endpoint that serves embeddings is often
# a different service with its own credentials. Same "base" convention as above.
# EMBEDDING_INPUT_TYPE / EMBEDDING_TRUNCATE are NIM-only extras (sent as
# extra_body), required by models such as nvidia/nemotron-3-embed-1b.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_INPUT_TYPE=
EMBEDDING_TRUNCATE=

# --- Logging ----------------------------------------------------------------
# Mirror every log line to a rotating file as well as stdout (empty = stdout
# only). Same bytes as the console: structlog events as JSON, uvicorn access
# lines as plain text. The test suite forces this empty.
LOG_FILE=logs/backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- App behaviour ----------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# Seeds demo@personalos.local / demo1234 on first boot.
SEED_DEMO_USER=true

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
